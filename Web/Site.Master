<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Site.Master.cs"
    Inherits="Aplicación_de_turnos_Barberia.Site" %>

<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Barbería</title>

    <!-- Bootstrap: estilos compartidos por todas las páginas -->
    <link href="<%= ResolveUrl("~/Content/bootstrap.min.css") %>"
      rel="stylesheet" />

<link href="<%= ResolveUrl("~/Content/estilos.css") %>"
      rel="stylesheet" />

    <!-- Espacio para contenido adicional de cada página -->
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>

<body>
    <form id="form1" runat="server">

        <!-- Menú compartido -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">

                <a class="navbar-brand" href="<%= ResolveUrl("~/Default.aspx") %>">
                    Barbería
                </a>

                <!-- En celular aparece este botón para abrir el menú -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal"
                        aria-expanded="false"
                        aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="menuPrincipal">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">

                        <li class="nav-item">
                            <a class="nav-link"
                               href="<%= ResolveUrl("~/Default.aspx") %>">
                                Inicio
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="<%= ResolveUrl("~/Servicios.aspx") %>">
                                Servicios
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="<%= ResolveUrl("~/Ingresar.aspx") %>">
                                Iniciar sesión
                            </a>
                        </li>

                       <li class="nav-item">
                            <a class="nav-link boton-registro"
                                href="RegistrateForm.aspx">
                                Registrarse
                                </a>
                       </li>
                                                    

                        <li class="nav-item">
                            <a class="btn btn-outline-light my-2 my-lg-0"
                               href="<%= ResolveUrl("~/ReservarTurno.aspx") %>">
                                Reservar turno
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>

        <!-- Acá se muestra el contenido de cada pantalla -->
        <main>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </main>

    </form>

    <!-- JavaScript de Bootstrap: permite desplegar el menú -->
    <script src="<%= ResolveUrl("~/Scripts/bootstrap.bundle.min.js") %>"></script>
</body>
</html>