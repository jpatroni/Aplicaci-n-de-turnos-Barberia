<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Site.Master.cs"
    Inherits="Aplicación_de_turnos_Barberia.Site" %>

<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Barbería</title>

    <!-- Bootstrap: estilos compartidos por todas las páginas -->
    <link href="<%= ResolveUrl("~/Content/bootstrap.min.css") %>"
      rel="stylesheet" />

<link href="<%= ResolveUrl("~/Content/estilos.css") %>?v=<%= System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Content/estilos.css")).Ticks %>"
      rel="stylesheet" />

    <!-- Espacio para contenido adicional de cada página -->
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>

<body>
    <form id="form1" runat="server">

        <!-- Menú compartido -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">

                <a class="navbar-brand" href="<%= ResolveUrl("~/Default.aspx") %>">
                    Barbería
                </a>

                <!-- En celular aparece este botón para abrir el menú -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal"
                        aria-expanded="false"
                        aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="menuPrincipal">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">

                        <li class="nav-item">
                            <a class="nav-link"
                               href="<%= ResolveUrl("~/Default.aspx") %>">
                                Inicio
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="<%= ResolveUrl("~/Servicios.aspx") %>">
                                Servicios
                            </a>
                        </li>

                      <li id="menuIngresar" runat="server" class="nav-item">
    <asp:HyperLink runat="server" NavigateUrl="~/Ingresar.aspx"
        CssClass="nav-link" Text="Iniciar sesión" />
</li>
                        <li id="menuRegistrarse" runat="server" class="nav-item">
    <asp:HyperLink runat="server" NavigateUrl="~/RegistrateForm.aspx"
        CssClass="nav-link boton-registro" Text="Registrarse" />
</li>

<li id="menuCerrarSesion" runat="server" class="nav-item" visible="false">
    <asp:Button ID="btnCerrarSesion" runat="server"
        Text="Cerrar sesión" CssClass="btn btn-outline-light"
        CausesValidation="false" OnClick="btnCerrarSesion_Click" />
</li>


                        <li class="nav-item">
                            <a class="btn btn-outline-light my-2 my-lg-0"
                               href="<%= ResolveUrl("~/ReservarTurno.aspx") %>">
                                Reservar turno
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>

        <!-- Acá se muestra el contenido de cada pantalla -->
        <main>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <!-- Contacto compartido: datos de muestra, sin enlaces. -->
        <footer class="pie-contacto" aria-labelledby="tituloContacto">
            <div class="container pie-contacto-contenido">
                <div>
                    <h2 id="tituloContacto">Contacto</h2>
                    <p>Teléfono: 11 5555-0100</p>
                </div>

                <div class="pie-contacto-redes" aria-label="Redes sociales">
                    <span class="pie-contacto-red">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                            <path d="M20.5 11.5a8.5 8.5 0 0 1-12.8 7.3L3 20l1.2-4.7A8.5 8.5 0 1 1 20.5 11.5Z" />
                            <path d="m8.2 7.2 1.4 2.7-1 1.1a10 10 0 0 0 4.4 4.1l1-1.1 2.8 1.3c-.3 1.4-1.1 2-2.3 1.8-4.3-.7-7.9-4.2-8.2-7.5-.1-1.1.6-2 1.9-2.4Z" />
                        </svg>
                        WhatsApp
                    </span>
                    <span class="pie-contacto-red">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false">
                            <rect x="3" y="3" width="18" height="18" rx="5" />
                            <circle cx="12" cy="12" r="4" />
                            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                        </svg>
                        Instagram
                    </span>
                </div>
            </div>
        </footer>

    </form>

    <!-- JavaScript de Bootstrap: permite desplegar el menú -->
    <script src="<%= ResolveUrl("~/Scripts/bootstrap.bundle.min.js") %>"></script>
</body>
</html>
